# Copy this file to ".env" and fill in the values. Never commit ".env".
DATABASE_URL="file:./dev.db"

# Secret used to sign login cookies. Must be 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# OPTIONAL, development only: `npm run db:seed` creates an admin from these.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
